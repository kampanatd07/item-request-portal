# Database
DATABASE_URL=postgresql+psycopg://app:app@db:5432/itemportal

# App
# SECRET_KEY signs the login session cookie; anyone who knows it can forge a
# login. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with a placeholder value when APP_ENV is not "dev".
SECRET_KEY=change-me
# "dev" on your own machine only. Unset or any other value means production:
# the Secure cookie flag (HTTPS only), no /docs, and a real SECRET_KEY required.
APP_ENV=dev

# Optional: Argon2 password-hash cost. Leave unset to use the secure defaults
# (time 3, memory 65536 KiB, parallelism 4). Tests lower these for speed only.
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536
# ARGON2_PARALLELISM=4

# Session length in hours from login (no "remember me"). Default 8.
# SESSION_MAX_HOURS=8

# Optional: enables AI-assisted search-name suggestions (soft dependency).
# Leave blank to use the deterministic dictionary only. Also requires
# `pip install anthropic`.
ANTHROPIC_API_KEY=

# Email (STORY-002). Full portal address used for links in emails, e.g.
# https://item-portal.example.com — leave empty and emails carry no link.
PUBLIC_BASE_URL=
# Procurement mailbox that receives replies to notification emails.
MAIL_REPLY_TO=
# Microsoft Graph sender (STORY-002 ticket 02). All four set → real email.
# Required unless APP_ENV=dev: the app refuses to start without them. In dev
# any one empty → emails are only logged. Ask IT for:
#   1. an App Registration in Entra ID (Azure AD) for the portal;
#   2. the Microsoft Graph *application* permission Mail.Send, with admin consent;
#   3. an Application Access Policy (Exchange Online) limiting the app to the
#      one sender mailbox below — without it the app could send as anyone;
#   4. a client secret — write its expiry date in docs/HANDOFF.md §7 and renew
#      it before then: after it expires every email fails with "Graph
#      credentials do not work ... check MS_CLIENT_SECRET".
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# Shared mailbox the emails come from, e.g. item-portal@carabao.co.th
# MAIL_SENDER=
# Sends per minute per app process, spaced evenly (25 → one every 2.4 s).
# Exchange allows ~30 per mailbox. Default 25.
# MAIL_RATE_PER_MINUTE=25

# Proxies in front of the app (STORY-006): IPs or CIDR ranges, comma
# separated, or "none" when clients connect directly. Only a request from one
# of these may say who the client is (X-Forwarded-For); the login limit per IP
# counts that address. List EVERY hop that appends to X-Forwarded-For (CDN and
# load balancer), and ONLY proxy addresses: never a range real clients can
# come from, or they can forge their IP (README, Deploying). Required unless
# APP_ENV=dev (the app, migrations and create_admin refuse to start without
# it); empty in dev means 127.0.0.1. "*" is refused: it would believe a
# client-written address. A trailing or extra comma is fine ("10.0.0.0/8,");
# only commas (" , ") count as unset.
# FORWARDED_ALLOW_IPS=
